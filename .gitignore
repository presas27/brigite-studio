# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# studio app local data (sqlite + uploads)
/.data

# raw Trainerize exports — the committed artefact is the generated seed
# (src/lib/studio/library-trainerize.ts), not the spreadsheet it came from
/scripts/trainerize/export

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed) — the template is documentation
# of which variables exist, never their values, so it belongs in the repo.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
