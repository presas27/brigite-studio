# --- Site (Next, no Vercel) --------------------------------------------------
#
# Resend — https://resend.com/api-keys
# O domínio brigitestudio.com tem de estar verificado no Resend (DNS:
# https://resend.com/domains). Usado só pelo formulário de contacto do site.
# Os emails da app (convites, reposição de palavra-passe) saem da deployment
# Convex — ver abaixo.
RESEND_API_KEY=

# Remetente. Omitido → Brigite's Studio <ola@brigitestudio.com>
EMAIL_FROM=

# --- App de treino (/app) ---------------------------------------------------
#
# A base de dados é o Convex. `npx convex dev` escreve as três variáveis
# abaixo no .env.local e é isso que liga a app à deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# No Vercel, em vez destas, define CONVEX_DEPLOY_KEY (Convex Dashboard →
# Settings → Deploy Keys). O `bun run build` faz `convex deploy --cmd
# 'next build'`, que publica as funções e injeta o NEXT_PUBLIC_CONVEX_URL certo.
CONVEX_DEPLOY_KEY=

# "1" mostra em /app/entrar um botão por conta provisionada (src/lib/studio/pilot.ts),
# que entra com a palavra-passe partilhada. Só para o ambiente de teste.
STUDIO_DEMO=

# --- Variáveis da deployment Convex ----------------------------------------
#
# Estas NÃO vivem aqui: vivem na deployment, porque é lá que o código que as lê
# corre. Define com `npx convex env set NOME valor` (ou no dashboard).
#
#   BETTER_AUTH_SECRET  segredo com que o Better Auth assina sessões e tokens.
#                       `npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"`
#   SITE_URL            origem da app, para os links de convite e de reposição
#                       (http://localhost:3000 em local, https://brigitestudio.com em produção)
#   RESEND_API_KEY      chave com que a deployment envia convites e links de
#                       reposição. Sem ela, o email é escrito nos logs da
#                       deployment — é assim que o fluxo se testa sem correio.
#   EMAIL_FROM          remetente. Omitido → Brigite's Studio <ola@brigitestudio.com>
#   STUDIO_DEMO         "1" para a mesma coisa que acima (o servidor lê esta cópia).
#   YOUTUBE_API_KEY     chave da YouTube Data API v3 (Google Cloud Console → APIs
#                       → Credentials), usada para procurar o vídeo de demonstração
#                       de um exercício. Cada procura custa 100 das 10.000 unidades
#                       diárias da quota, ou seja ~95 exercícios por dia:
#
#                         bunx convex run youtube:backfill '{"limit": 45}'
#
#                       Sem a chave, o botão "Procurar no YouTube" falha com aviso
#                       e o link continua a poder ser colado à mão.
#
# Contas provisionadas (uma treinadora, uma aluna dela, um aluno por conta
# própria), com a palavra-passe partilhada de src/lib/studio/pilot.ts:
#
#   bun run provision        # seed:accounts + biblioteca + treinos base
