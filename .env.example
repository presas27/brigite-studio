# Resend — https://resend.com/api-keys
# O domínio brigitestudio.com tem de estar verificado no Resend para enviar
# de site@brigitestudio.com (DNS: https://resend.com/domains).
# Usado pelo formulário de contacto e pelo convite que a Sara envia a um aluno.
RESEND_API_KEY=

# --- App de treino (/app) ---------------------------------------------------
#
# A base de dados é o Convex. Não há ficheiro, não há volume, não há nada que
# desapareça entre pedidos: `npx convex dev` escreve as três variáveis abaixo
# no .env.local e é isso que liga a app à deployment.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# No Vercel, em vez destas, define CONVEX_DEPLOY_KEY (Convex Dashboard →
# Settings → Deploy Keys). O `bun run build` faz `convex deploy --cmd
# 'next build'`, que publica as funções e injeta o NEXT_PUBLIC_CONVEX_URL certo.
CONVEX_DEPLOY_KEY=

# Usado para montar o URL do convite enviado por email.
# Omitido → site.url (https://brigitestudio.com)
NEXT_PUBLIC_SITE_URL=

# --- Variáveis da deployment Convex ----------------------------------------
#
# Estas NÃO vivem aqui: vivem na deployment, porque é lá que o código que as lê
# corre. Define com `npx convex env set NOME valor` (ou no dashboard).
#
#   SITE_URL          origem da app, para montar o link de acesso
#                     (http://localhost:3000 em local, https://brigitestudio.com em produção)
#   AUTH_RESEND_KEY   chave Resend com que a deployment envia o link de acesso.
#                     Sem ela, o link é escrito nos logs da deployment em vez de
#                     ser enviado — é assim que o fluxo se testa sem email.
#   AUTH_EMAIL_FROM   remetente do link. Omitido → Brigite's Studio <ola@brigitestudio.com>
#   STUDIO_DEMO       "1" abre a entrada direta em /app/entrar (um botão por
#                     conta do piloto, sem email). Só para o ambiente de teste.
