# Resend — https://resend.com/api-keys
# O domínio brigitestudio.com tem de estar verificado no Resend para enviar
# de site@brigitestudio.com (DNS: https://resend.com/domains).
RESEND_API_KEY=

# --- App de treino (/app) ---------------------------------------------------

# Chave de assinatura das sessões e dos links de acesso. Sem isto, cai para
# CONTACT_FORM_SECRET → RESEND_API_KEY → fallback de desenvolvimento. Define
# em produção: `openssl rand -hex 32`.
STUDIO_SECRET=

# Email da conta de treinadora criada no primeiro arranque.
# Omitido → hello@brigitestudio.com
STUDIO_COACH_EMAIL=

# STUDIO_DEMO=1 cria também uma aluna de demonstração com uma semana de plano.
# Só para desenvolvimento.
STUDIO_DEMO=

# Usado para montar o URL do link de acesso enviado por email.
# Omitido → site.url (https://brigitestudio.com)
NEXT_PUBLIC_SITE_URL=
