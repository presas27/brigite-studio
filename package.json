{
  "name": "brigite-studio",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "if [ \"$VERCEL_ENV\" = production ]; then convex deploy --cmd 'next build'; else next build; fi",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint",
    "provision": "convex run seed:accounts && convex run seed:importLibrary && convex run seed:masterWorkouts",
    "trainerize:export": "bun run scripts/trainerize/export.ts",
    "trainerize:import": "bun run scripts/trainerize/import.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "gsap": "^3.15.0",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
